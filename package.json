{
  "scripts": {
    "test": "xo",
    "build": "zip -r isometric-contributions.zip src/*",
    "release": "release:*",
    "release:ff": "npx web-ext-submit --source-dir src",
    "release:chrome": "npx webstore upload --source=isometric-contributions.zip --auto-publish",
    "prepublish": "npm run snyk-protect",
    "snyk-protect": "snyk-protect"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "^2.0.0",
    "web-ext-submit": "^7.0.0",
    "xo": "^0.42.0"
  },
  "xo": {
    "semicolon": false,
    "space": true,
    "prefer-numeric-literals": 0,
    "global": [
      "obelisk",
      "chrome"
    ],
    "env": [
      "browser"
    ],
    "ignores": [
      "src/webext-domain-permission-toggle.js",
      "src/background.js"
    ]
  },
  "snyk": true,
  "dependencies": {
    "@snyk/protect": "latest"
  }
}
